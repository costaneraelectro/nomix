rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // App interna de tienda sin login. Si agregas Firebase Auth,
    // cambia `if true` por `if request.auth != null`.
    match /ventas/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.monto is number
                            && request.resource.data.monto > 0
                            && request.resource.data.vendedorCodigo is string
                            && request.resource.data.sublinea is string;
    }
    match /vendedores/{codigo} {
      allow read: if true;
      allow create, update: if request.resource.data.codigo is string
                            && request.resource.data.nombre is string;
    }
  }
}
