rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // App interna de tienda sin login: solo la colección "ventas".
    // Si más adelante agregas Firebase Auth, cambia a `request.auth != null`.
    match /ventas/{id} {
      allow read: if true;
      allow create: if request.resource.data.monto is number
                    && request.resource.data.monto > 0
                    && request.resource.data.vendedorCodigo is string
                    && request.resource.data.sublinea is string;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['boleteado']);
      allow delete: if true;
    }
  }
}
